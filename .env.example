# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

SITE_NAME=Prajin S | Portfolio
SITE_DOMAIN=localhost:8000
SITE_URL=http://localhost:8000

# Optional: enables the GitHub activity section on the homepage.
# Leave blank to hide that section entirely.
GITHUB_USERNAME=

# --- Database ---
# Leave blank to use SQLite locally. For production:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Media storage ---
# Leave all blank to store admin-uploaded images (Profile photo/
# illustration, Project image/hero_image/screenshots) on local disk —
# fine for dev, and for any host with a persistent filesystem. Required
# on hosts with an *ephemeral* filesystem (e.g. Render's free tier),
# where local uploads are wiped on every redeploy/restart. From a free
# Cloudinary account's dashboard -> Account Details, use EITHER:
#   - the three separate values below (easier to paste correctly — no
#     URL syntax to get right), OR
#   - the single "API Environment variable" as CLOUDINARY_URL instead
#     (cloudinary://<api_key>:<api_secret>@<cloud_name>) — takes
#     precedence over the three separate vars if both are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

TIME_ZONE=Asia/Kolkata

# --- Resume file ---
# Drop your PDF at media/resume/<RESUME_FILE_NAME>
RESUME_FILE_NAME=resume.pdf

# --- Email (contact form) ---
# Defaults to printing emails to the console in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
CONTACT_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=portfolio@example.com

# --- Production security ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
